---
import SectionHeading from './SectionHeading.astro';
---

<section id="stats" class="relative py-24 px-4">
  <div class="max-w-5xl mx-auto">
    <SectionHeading
      title="Estadísticas de GitHub"
      subtitle="Mi actividad y lenguajes más utilizados en GitHub."
    />

    <div class="flex flex-col items-center gap-8 stagger-3 animate-fade-in-up">
      <div class="flex flex-wrap justify-center gap-6">
        <img src="https://github-readme-stats-tau-ten-51.vercel.app/api?username=dawcarlosp&show_icons=true&theme=tokyonight&count_private=true&rank_icon=github&border_radius=10" width="495" height="195" alt="GitHub Stats" loading="lazy" onerror="this.style.display='none'" />
        <img src="https://github-readme-stats-tau-ten-51.vercel.app/api/top-langs/?username=dawcarlosp&layout=donut&theme=tokyonight&langs_count=5&border_radius=10" width="495" height="195" alt="Top Languages" loading="lazy" onerror="this.style.display='none'" />
      </div>
    </div>
  </div>
</section>
