---
import '../styles/global.css';
import Background from '../components/Background.astro';

const { title = 'Carlos Pereira | Full Stack Developer' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Space+Grotesk:wght@500;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Space+Grotesk:wght@500;700&display=swap" /></noscript>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Portfolio de Carlos Pereira - Desarrollador Web Full Stack Jr. especializado en Java, Spring Boot, React y tecnologías web modernas." />
    <meta name="keywords" content="desarrollador web, full stack, java, spring boot, react, portfolio" />
    <meta name="author" content="Carlos Pereira" />
    <meta property="og:title" content="Carlos Pereira | Full Stack Developer" />
    <meta property="og:description" content="Portfolio de Carlos Pereira - Desarrollador Web Full Stack Jr." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class="text-text-primary font-sans min-h-screen overflow-x-hidden">
    <Background />
    <div class="relative z-10">
      <slot />
    </div>
    <script>
      document.addEventListener('visibilitychange', () => {
        document.querySelectorAll('svg.fixed').forEach((el) => {
          if (el instanceof SVGSVGElement) {
            if (document.hidden) {
              el.pauseAnimations();
            } else {
              el.unpauseAnimations();
            }
          }
        });
        document.body.classList.toggle('anim-paused', document.hidden);
      });

      (function () {
        const backdrop = document.getElementById('background-backdrop');
        const svg = document.getElementById('background-svg');
        if (!backdrop || !svg) return;

        const MARGIN = 1.5; // backdrop = viewport * MARGIN to cover dynamic viewport changes

        // Keep a stable maximum viewport size so we don't resize the SVG on every scroll
        let maxVW = 0;
        let maxVH = 0;
        let bw = 0;
        let bh = 0;
        let offsetX = 0;
        let offsetY = 0;

        function recalcSizes() {
          const vp = window.visualViewport;
          const vw = vp ? Math.round(vp.width) : window.innerWidth;
          const vh = vp ? Math.round(vp.height) : window.innerHeight;

          // only grow the max dimensions (or set initially) — do not shrink on transient viewport changes
          if (!maxVW || vw > maxVW) maxVW = vw;
          if (!maxVH || vh > maxVH) maxVH = vh;

          bw = Math.round(maxVW * MARGIN);
          bh = Math.round(maxVH * MARGIN);
          offsetX = Math.round((bw - maxVW) / 2);
          offsetY = Math.round((bh - maxVH) / 2);

          // size backdrop to the (stable) oversized dimensions
          backdrop.style.width = `${bw}px`;
          backdrop.style.height = `${bh}px`;

          // position backdrop according to the current visualViewport offsets
          const top = vp ? Math.round(vp.offsetTop - offsetY) : -offsetY;
          const left = vp ? Math.round(vp.offsetLeft - offsetX) : -offsetX;
          backdrop.style.top = `${top}px`;
          backdrop.style.left = `${left}px`;

          // make the SVG fill the oversized backdrop and keep it stable
          svg.style.width = `${bw}px`;
          svg.style.height = `${bh}px`;
          svg.style.top = `0px`;
          svg.style.left = `0px`;
        }

        function updatePosition() {
          const vp = window.visualViewport;
          if (!vp) return;
          const top = Math.round(vp.offsetTop - offsetY);
          const left = Math.round(vp.offsetLeft - offsetX);
          backdrop.style.top = `${top}px`;
          backdrop.style.left = `${left}px`;
          // keep svg size and position stable while scrolling
        }

        let ticking = false;
        function requestUpdate() {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              updatePosition();
              ticking = false;
            });
            ticking = true;
          }
        }

        // Scroll start / end detection to pause heavy SVG animations and try absolute positioning during momentum scroll on mobile
        let scrollEndTimer = null;
        const SCROLL_END_DELAY = 150; // ms

        function onScrollStart() {
          // only on small viewports
          if (window.matchMedia && window.matchMedia('(max-width: 768px)').matches) {
            document.body.classList.add('bg-scrolling');
            backdrop.classList.add('bg-scrolling');
          }
          if (scrollEndTimer) {
            clearTimeout(scrollEndTimer);
          }
          scrollEndTimer = setTimeout(onScrollEnd, SCROLL_END_DELAY);
        }

        function onScrollEnd() {
          document.body.classList.remove('bg-scrolling');
          backdrop.classList.remove('bg-scrolling');
          scrollEndTimer = null;
        }

        if (window.visualViewport) {
          // Recalculate sizes on actual resize events (keyboard show/hide, orientation change)
          window.visualViewport.addEventListener('resize', () => { recalcSizes(); updatePosition(); });
          // During scroll only update position (no svg resize)
          window.visualViewport.addEventListener('scroll', (ev) => { requestUpdate(); onScrollStart(); });
        } else {
          window.addEventListener('resize', () => { recalcSizes(); updatePosition(); }, { passive: true });
        }

        window.addEventListener('orientationchange', () => { recalcSizes(); updatePosition(); });
        recalcSizes();
      })();
    </script>
    <style is:global>
      .anim-paused svg * {
        animation-play-state: paused !important;
      }
    </style>
  </body>
</html>
