---
import '../styles/global.css';
import Background from '../components/Background.astro';

const { title = 'Carlos Pereira | Full Stack Developer' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Space+Grotesk:wght@500;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Space+Grotesk:wght@500;700&display=swap" /></noscript>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Portfolio de Carlos Pereira - Desarrollador Web Full Stack Jr. especializado en Java, Spring Boot, React y tecnologías web modernas." />
    <meta name="keywords" content="desarrollador web, full stack, java, spring boot, react, portfolio" />
    <meta name="author" content="Carlos Pereira" />
    <meta property="og:title" content="Carlos Pereira | Full Stack Developer" />
    <meta property="og:description" content="Portfolio de Carlos Pereira - Desarrollador Web Full Stack Jr." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class="text-text-primary font-sans min-h-screen overflow-x-hidden">
    <Background />
    <div class="relative z-10">
      <slot />
    </div>
    <script>
      document.addEventListener('visibilitychange', () => {
        document.querySelectorAll('svg.fixed').forEach((el) => {
          if (el instanceof SVGSVGElement) {
            if (document.hidden) {
              el.pauseAnimations();
            } else {
              el.unpauseAnimations();
            }
          }
        });
        document.body.classList.toggle('anim-paused', document.hidden);
      });

      (function () {
        const backdrop = document.getElementById('background-backdrop');
        const svg = document.getElementById('background-svg');
        if (!backdrop || !svg) return;

        const MARGIN = 1.5; // backdrop = viewport * MARGIN to cover dynamic viewport changes

        function updateBackdrop() {
          const vp = window.visualViewport;
          const vw = vp ? Math.round(vp.width) : window.innerWidth;
          const vh = vp ? Math.round(vp.height) : window.innerHeight;
          const bw = Math.round(vw * MARGIN);
          const bh = Math.round(vh * MARGIN);
          const offsetX = Math.round((bw - vw) / 2);
          const offsetY = Math.round((bh - vh) / 2);

          backdrop.style.width = `${bw}px`;
          backdrop.style.height = `${bh}px`;
          backdrop.style.top = vp ? `${Math.round(vp.offsetTop - offsetY)}px` : `-${offsetY}px`;
          backdrop.style.left = vp ? `${Math.round(vp.offsetLeft - offsetX)}px` : `-${offsetX}px`;

          svg.style.width = `${vw}px`;
          svg.style.height = `${vh}px`;
          svg.style.top = `${offsetY}px`;
          svg.style.left = `${offsetX}px`;
        }

        let ticking = false;
        function requestUpdate() {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              updateBackdrop();
              ticking = false;
            });
            ticking = true;
          }
        }

        if (window.visualViewport) {
          window.visualViewport.addEventListener('resize', requestUpdate);
          window.visualViewport.addEventListener('scroll', requestUpdate);
        } else {
          window.addEventListener('resize', requestUpdate, { passive: true });
        }
        window.addEventListener('orientationchange', updateBackdrop);
        updateBackdrop();
      })();
    </script>
    <style is:global>
      .anim-paused svg * {
        animation-play-state: paused !important;
      }
    </style>
  </body>
</html>
